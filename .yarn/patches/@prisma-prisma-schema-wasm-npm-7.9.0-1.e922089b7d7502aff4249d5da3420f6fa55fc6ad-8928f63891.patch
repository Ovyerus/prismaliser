+// Browser-compatible init: the original nodejs-target tail read the wasm from
+// disk with `fs.readFileSync(__dirname + ...)` and self-instantiated at import
+// time. Instead, export an explicit init that accepts the wasm bytes (fetched
+// by the host app) and instantiates on demand.
+let wasm;
+
+exports.__init = function (wasmBytes) {
+    const wasmModule = new WebAssembly.Module(wasmBytes);
+    wasm = exports.__wasm = new WebAssembly.Instance(wasmModule, imports).exports;
+    wasm.__wbindgen_start();
+};
 
